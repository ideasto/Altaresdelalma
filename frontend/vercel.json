{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "create-react-app",
  "installCommand": "corepack yarn install --frozen-lockfile --non-interactive",
  "buildCommand": "corepack yarn build",
  "outputDirectory": "build",
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
